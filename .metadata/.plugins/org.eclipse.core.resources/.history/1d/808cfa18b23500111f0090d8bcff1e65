package Java_Programme;

public class Rotate_By_all_number {

	public static void main(String[] args) 
	{
		
		int arr[] = {1,2,3,4,5};
		
		for(int a=0 ; a<4; a++)
		{
			int last = arr[arr.length-1];
			
			for(int b=arr.length-1 ; b>=0 ; b--)
			{
				arr[b] = arr[b-1];
			}
			
			arr[0] = last;
			
			for(int x : arr)
			{
				System.out.println( x+" ");
			}
		}

	}

}
