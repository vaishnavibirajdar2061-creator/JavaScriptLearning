package Java_Programme;

public class Find_Common_Element {

	public static void main(String[] args) 
	{
	
		int arr1[]= {1,2,3,4,5};
		int arr2[]= {3,4,5,6,7,8};
		
		for(int a=0 ; a<=arr1.length ; a++)
		{
			for(int b=0 ; b<=arr2.length ; b++)
			{
				if (arr1[a] == arr2[b])
				{
					System.out.println(arr1[a]);
				}
			}
		}

	}

}
