package Java_Programme;

public class miss_number_inArray_10 {

	public static void main(String[] args) 
	{
		
      int arr []= {10,20,30,40,50,70};
      
      int min =10 ;
      int max = 70;
      int total = (max-min)/10+1;
      int sum =0 ;
      
      for(int a=0 ; a<arr.length; a++)
      {
    	  sum = sum + arr[a];
      }
      
      int miss = total - sum ;
      System.out.println("missing number :" + miss);
	}

}
